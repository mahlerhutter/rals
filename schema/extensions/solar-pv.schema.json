{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rals.org/schema/v0.1/extensions/solar-pv.schema.json",
  "title": "RALS Extension: Solar PV",
  "type": "object",
  "properties": {
    "technical": {
      "properties": {
        "module": {
          "type": "object",
          "properties": {
            "technology": {
              "type": "string",
              "enum": ["monocrystalline_perc", "monocrystalline_topcon", "thin_film", "heterojunction"]
            },
            "bifacial": { "type": "boolean" },
            "nominal_power_w": { "type": "number" }
          }
        },
        "mounting": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["fixed_tilt", "single_axis_tracker", "dual_axis_tracker", "roof_mounted", "floating"]
            }
          }
        }
      }
    }
  }
}
