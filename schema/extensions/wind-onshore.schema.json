{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rals.org/schema/v0.1/extensions/wind-onshore.schema.json",
  "title": "RALS Extension: Onshore Wind",
  "type": "object",
  "properties": {
    "technical": {
      "properties": {
        "turbine_configurations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "manufacturer": { "type": "string" },
              "model": { "type": "string" },
              "nominal_power_mw": { "type": "number" },
              "rotor_diameter_m": { "type": "number" },
              "hub_height_m": { "type": "number" },
              "iec_class": { "type": "string" }
            }
          }
        },
        "wind_resource": {
          "type": "object",
          "properties": {
            "average_wind_speed_m_s": { "type": "number" },
            "measurement_height_m": { "type": "number" }
          }
        }
      }
    }
  }
}
